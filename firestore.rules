rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidWritingMode(mode) {
      return mode in ["fountainPen", "typewriter"];
    }

    // Single hardcoded admin account, identified by username (this app has
    // no real-email accounts — Firebase Auth uses a synthetic address). Used
    // to let the admin console list/delete any account's data for test
    // cleanup. The get() here is independent of the document being
    // evaluated, so it doesn't block admin list queries across a collection.
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == "birkleyg";
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.mailboxName is string;

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isOwner(userId) || isAdmin();

      match /bins/{binId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /usernames/{username} {
      // Required for username lookup before sign-in.
      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;

      allow update, delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /letters/{letterId} {
      // Sender, direct recipient, or invite claimant can read.
      // For invite-sent letters (status "sent" with inviteId), any signed-in
      // user can read — the invite link is the proof of access. The update
      // rules still enforce that only the invite claimant can claim.
      // The isAdmin() branch is independent of resource.data, so it also
      // permits the admin console's list-all-letters query.
      allow read: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid
            || (
              resource.data.inviteId is string
              && resource.data.status == "sent"
            )
          )
        );

      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == "draft"
        && isValidWritingMode(request.resource.data.writingMode);

      // Sender: maintain drafts and send them.
      allow update: if isSignedIn()
        && resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && (
          (resource.data.status == "draft"
            && request.resource.data.status in ["draft", "inTransit", "sent"])
          || (resource.data.status == "inTransit"
            && request.resource.data.status == "inTransit")
        );

      // Invite claimants can attach pending invite letters to their account.
      // Single-claim is enforced by the toUid == null precondition: once a
      // letter has been claimed (toUid set), no other user can claim it.
      // The invite document's own update rule (below) independently verifies
      // the invite was claimed by the same user.
      allow update: if isSignedIn()
        && resource.data.status == "sent"
        && resource.data.inviteId is string
        && (!("toUid" in resource.data) || resource.data.toUid == null)
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.inviteId == resource.data.inviteId
        && request.resource.data.toUid == request.auth.uid
        && request.resource.data.status in ["inTransit", "delivered"];

      // A sender may rotate an unclaimed invitation without changing letter content.
      allow update: if isSignedIn()
        && resource.data.fromUid == request.auth.uid
        && resource.data.status == "sent"
        && resource.data.inviteStatus == "pending"
        && request.resource.data.status == "sent"
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["inviteId", "inviteStatus", "updatedAt"]);

      // Recipient can only perform mailbox-side actions.
      allow update: if isSignedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status in ["delivered", "opened"]
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(["status", "openedAt", "updatedAt", "binId"]);

      allow delete: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
          || isAdmin());
    }

    match /invites/{inviteId} {
      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.status == "pending"
        && request.resource.data.senderUid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.status == "pending"
        && request.resource.data.status == "claimed"
        && request.resource.data.claimedByUid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.status == "pending"
        && request.resource.data.status == "replaced"
        && get(/databases/$(database)/documents/letters/$(resource.data.letterId)).data.fromUid == request.auth.uid;

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
